{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "will-pixel",
  "version": "0.1.0",
  "identifier": "com.will.pixel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "will-pixel",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "label": "main",
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "title": "will-pixel",
        "width": 320,
        "height": 280,
        "center": true,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "WiliamMP",
    "shortDescription": "Editor de pixel art com tema Neon",
    "copyright": "© 2026 WiliamMP",
    "category": "GraphicsAndDesign",
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR"
        ],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
